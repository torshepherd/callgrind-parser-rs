.bail on
.headers off
.mode list

PRAGMA query_only = ON;
PRAGMA temp_store = MEMORY;
PRAGMA mmap_size = 0;
PRAGMA cache_size = @SQLITE_CACHE_PAGES@;

-- Indexed point probes, representative of an OLTP access pattern.
WITH RECURSIVE probe(n) AS (
  VALUES(1)
  UNION ALL
  SELECT n + 1 FROM probe WHERE n < 2500
)
SELECT sum((
  SELECT amount_cents
  FROM purchase
  WHERE id = ((probe.n * 7919) % 50000) + 1
))
FROM probe;

-- A selective range scan joined to a dimension table.
SELECT
  customer.region,
  count(*),
  sum(purchase.amount_cents)
FROM purchase
JOIN customer ON customer.id = purchase.customer_id
WHERE purchase.day BETWEEN 180 AND 365
  AND customer.status = 'active'
GROUP BY customer.region
ORDER BY customer.region;

-- Aggregation through a covering index.
SELECT
  category,
  count(*),
  min(amount_cents),
  max(amount_cents),
  sum(amount_cents)
FROM purchase
GROUP BY category
ORDER BY category;

-- Sorting and a window function exercise temporary B-trees and repeated reads.
SELECT sum(running_total)
FROM (
  SELECT sum(amount_cents) OVER (
    PARTITION BY customer_id
    ORDER BY day, id
    ROWS BETWEEN 8 PRECEDING AND CURRENT ROW
  ) AS running_total
  FROM purchase
  WHERE customer_id <= 750
);

-- Repeat a broad scan so the small and large SQLite page caches diverge.
SELECT count(*), sum(length(payload)), sum(amount_cents)
FROM purchase
WHERE day >= 90;

SELECT count(*), sum(length(payload)), sum(amount_cents)
FROM purchase
WHERE day >= 90;
